{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true, "esModuleInterop": true,
    "resolveJsonModule": true, "skipLibCheck": true, "declaration": true,
    "sourceMap": true, "outDir": "dist", "rootDir": ".", "types": ["node"],
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src/**/*.ts", "vendor/**/*.ts"],
  "exclude": ["node_modules", ".upstream", ".tools", "tests"]
}
