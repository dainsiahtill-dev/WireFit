{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wirefix.invalid/contracts/research-request.schema.json",
  "title": "Research experiment request: one direction identifier plus a resolved budget",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "research_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "direction_id": {
      "enum": [
        "D01",
        "D02",
        "D03",
        "D04",
        "D05",
        "D06",
        "D07",
        "D08",
        "D09",
        "D10",
        "D11",
        "D12",
        "D13",
        "D14",
        "D15",
        "D16",
        "D17"
      ]
    },
    "budget": {
      "$ref": "budget.schema.json"
    }
  },
  "required": [
    "schema_version",
    "research_id",
    "direction_id",
    "budget"
  ],
  "additionalProperties": false
}
