{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wirefix.invalid/contracts/budget.schema.json",
  "title": "Resolved experiment budget",
  "type": "object",
  "properties": {
    "wall_time_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400000
    },
    "solver_soft_time_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400000
    },
    "solver_hard_time_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400000
    },
    "max_candidates": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5000000
    },
    "max_ast_nodes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "max_oracle_calls": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000000
    },
    "max_iterations": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000000
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    }
  },
  "required": [
    "wall_time_ms",
    "solver_soft_time_ms",
    "solver_hard_time_ms",
    "max_candidates",
    "max_ast_nodes",
    "max_oracle_calls",
    "max_iterations",
    "seed"
  ],
  "additionalProperties": false
}
