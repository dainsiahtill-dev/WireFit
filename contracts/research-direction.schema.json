{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wirefix.invalid/contracts/research-direction.schema.json",
  "title": "Research direction specification with pre-registered claims, thresholds and checks",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "direction_id": {
      "enum": [
        "D01",
        "D02",
        "D03",
        "D04",
        "D05",
        "D06",
        "D07",
        "D08",
        "D09",
        "D10",
        "D11",
        "D12",
        "D13",
        "D14",
        "D15",
        "D16",
        "D17"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "corpus_role": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "primary_claim_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "split": {
      "$ref": "#/$defs/split"
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "evidence_pins": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/evidence_pin"
      }
    }
  },
  "required": [
    "schema_version",
    "direction_id",
    "title",
    "corpus_role",
    "primary_claim_id",
    "split",
    "claims",
    "evidence_pins"
  ],
  "additionalProperties": false,
  "$defs": {
    "split": {
      "type": "object",
      "properties": {
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "rule": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "expected_counts": {
          "type": "object",
          "properties": {
            "train": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "validation": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "holdout": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "train",
            "validation",
            "holdout"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "unit",
        "key",
        "rule",
        "seed",
        "expected_counts"
      ],
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "properties": {
        "claim_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "hypothesis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "control": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "data_split": {
          "$ref": "#/$defs/split"
        },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/metric"
          }
        },
        "failure_condition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/spec_check"
          }
        },
        "not_claimed": {
          "type": "array",
          "minItems": 0,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "limitations": {
          "type": "array",
          "minItems": 0,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        }
      },
      "required": [
        "claim_id",
        "hypothesis",
        "control",
        "data_split",
        "metrics",
        "failure_condition",
        "checks",
        "not_claimed",
        "limitations"
      ],
      "additionalProperties": false
    },
    "metric": {
      "type": "object",
      "properties": {
        "metric_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "boolean"
            }
          ]
        },
        "comparator": {
          "enum": [
            "eq",
            "ne",
            "gte",
            "lte",
            "gt",
            "lt"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "metric_id",
        "description",
        "threshold",
        "comparator",
        "source"
      ],
      "additionalProperties": false
    },
    "spec_check": {
      "type": "object",
      "properties": {
        "check_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "role": {
          "enum": [
            "primary",
            "negative_control"
          ]
        },
        "derivation": {
          "$ref": "#/$defs/derivation"
        },
        "comparator": {
          "enum": [
            "eq",
            "ne",
            "gte",
            "lte",
            "gt",
            "lt",
            "identical_set",
            "subset",
            "superset"
          ]
        },
        "expected": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "boolean"
            }
          ]
        },
        "source_roles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "required": [
        "check_id",
        "statement",
        "role",
        "derivation",
        "comparator",
        "expected",
        "source_roles"
      ],
      "additionalProperties": false
    },
    "derivation": {
      "type": "object",
      "properties": {
        "kernel": {
          "enum": [
            "row_count",
            "distinct_count",
            "field_count",
            "field_sum",
            "field_min",
            "field_max",
            "all_equal",
            "any_equal",
            "set_equality",
            "file_sha256",
            "byte_pattern_count"
          ]
        },
        "artifact_role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "path": {
          "type": "string",
          "maxLength": 512
        },
        "field": {
          "type": "string",
          "maxLength": 128
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "boolean"
            }
          ]
        },
        "second_artifact_role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "second_path": {
          "type": "string",
          "maxLength": 512
        },
        "pattern_hex": {
          "type": "string",
          "maxLength": 4096,
          "pattern": "^([0-9a-fA-F]{2})+$"
        }
      },
      "required": [
        "kernel",
        "artifact_role"
      ],
      "additionalProperties": false
    },
    "evidence_pin": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "expected_sha256": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "size_bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "enum": [
            "stable_corpus",
            "lane_artifact"
          ]
        }
      },
      "required": [
        "role",
        "path",
        "expected_sha256",
        "size_bytes",
        "kind"
      ],
      "additionalProperties": false
    }
  }
}
