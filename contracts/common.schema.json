          "additionalProperties": false
        }
      ]
    },
    "bv_value": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "bv"
            },
            "width": {
              "const": 8
            },
            "bits": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{2}$"
            }
          },
          "required": [
            "kind",
            "width",
            "bits"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "bv"
            },
            "width": {
              "const": 16
            },
            "bits": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{4}$"
            }
