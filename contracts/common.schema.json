{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wirefix.invalid/contracts/common.schema.json",
  "title": "WireFix shared definitions",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "decimal_nonnegative": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$"
    },
    "bv_type": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "bv"
        },
        "width": {
          "enum": [
            8,
            16,
            32,
            64
          ]
        }
      },
      "required": [
        "kind",
        "width"
      ],
      "additionalProperties": false
    },
    "bool_type": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "bool"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "fp32_type": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "fp32"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "type": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "bv"
            },
            "width": {
              "enum": [
                8,
                16,
                32,
                64
              ]
            }
          },
          "required": [
            "kind",
            "width"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "bool"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "fp32"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    },
    "core_type": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "bv"
            },
            "width": {
              "enum": [
                8,
                16,
                32,
                64
              ]
            }
          },
          "required": [
            "kind",
            "width"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "bool"
            }
          },
          "required": [
            "kind"
