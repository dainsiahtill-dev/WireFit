        "provider_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "analysis_profile_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "target_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "bundle_sha256",
        "evidence_id",
        "provider_id",
        "analysis_profile_digest",
        "target_sha256",
        "location"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source_kind": {
          "enum": [
            "manual",
            "rea_portable",
            "rea_live",
            "oracle_fit"
          ]
        },
        "source_ref": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/rea_source_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_artifacts": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/artifact_ref"
          },
          "minItems": 0,
          "maxItems": 128
        },
        "notes": {
          "type": "string",
          "maxLength": 4096
        }
      },
      "required": [
        "source_kind",
        "source_ref",
        "source_artifacts",
        "notes"
      ],
      "additionalProperties": false
    },
    "sample_source": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "inputs_artifact"
            },
            "artifact": {
              "$ref": "common.schema.json#/$defs/artifact_ref"
            }
          },
          "required": [
            "kind",
            "artifact"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "dataset"
            },
            "dataset_id": {
              "$ref": "common.schema.json#/$defs/id"
            }
          },
          "required": [
            "kind",
            "dataset_id"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
