{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wirefix.invalid/contracts/emulation-request.schema.json",
  "title": "Declarative native function emulation request",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "emulation_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "code": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "file_offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1099511627775
        },
        "virtual_address": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        }
      },
      "required": [
        "file",
        "sha256",
        "file_offset",
        "virtual_address",
        "size_bytes"
      ],
      "additionalProperties": false
    },
    "regions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "base": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 268435456
          },
          "read": {
            "type": "boolean"
          },
          "write": {
            "type": "boolean"
          },
          "execute": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "base",
          "size_bytes",
          "read",
          "write",
          "execute"
        ],
        "additionalProperties": false
      }
    },
    "initial_memory": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "properties": {
          "region": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 268435456
          },
          "encoding": {
            "enum": [
              "bytes_hex",
              "int32_le",
              "uint32_le",
              "int8"
            ]
          },
          "value": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 4294967295
          },
          "fill_hex": {
            "type": "string",
            "pattern": "^([0-9a-fA-F]{2})*$",
            "maxLength": 4096
          },
          "repeat": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1048576
          },
          "count_expression": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "value_expression": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "region",
          "offset",
          "encoding"
        ],
        "additionalProperties": false
      }
    },
    "input_fills": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "properties": {
          "input": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "region": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 268435456
          },
          "encoding": {
            "enum": [
              "bytes_hex",
              "int32_le",
              "uint32_le",
              "int8"
            ]
          },
          "element_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          },
          "stride_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1048576
          },
          "count_expression": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "stride_expression": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "elements_per_row_expression": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "input",
          "region",
          "offset",
          "encoding"
        ],
        "additionalProperties": false
      }
    },
    "registers": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "pattern": "^(eax|ebx|ecx|edx|esi|edi|ebp|esp|eip|eflags)$"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 4294967295
      }
    },
    "call": {
      "type": "object",
      "properties": {
        "stack_region": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "stack_pointer_offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 268435456
        },
        "return_address": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "stop_address": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "required": [
        "stack_region",
        "stack_pointer_offset",
        "return_address",
        "stop_address"
      ],
      "additionalProperties": false
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "source": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "register",
                  "memory"
                ]
              },
              "register": {
                "type": "string",
                "pattern": "^(eax|ebx|ecx|edx|esi|edi|ebp|esp|eip|eflags)$"
              },
              "region": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "offset": {
                "type": "integer",
                "minimum": 0,
                "maximum": 268435456
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1048576
              }
            },
            "required": [
              "kind"
            ],
            "additionalProperties": false
          },
          "encoding": {
            "enum": [
              "bv32",
              "bv64",
              "uint32",
              "int32",
              "fp32"
            ]
          }
        },
        "required": [
          "id",
          "source",
          "encoding"
        ],
        "additionalProperties": false
      }
    },
    "captures": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "region": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 268435456
          },
          "size_expression": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "id",
          "region",
          "offset"
        ],
        "additionalProperties": false
      }
    },
    "policy": {
      "type": "object",
      "properties": {
        "readable": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "properties": {
              "region": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "offset": {
                "type": "integer",
                "minimum": 0,
                "maximum": 268435456
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 268435456
              }
            },
            "required": [
              "region"
            ],
            "additionalProperties": false
          }
        },
        "writable": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "properties": {
              "region": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "offset": {
                "type": "integer",
                "minimum": 0,
                "maximum": 268435456
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 268435456
              }
            },
            "required": [
              "region"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "properties": {
        "max_instructions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        }
      },
      "required": [
        "max_instructions"
      ],
      "additionalProperties": false
    },
    "notes": {
      "type": "string",
      "maxLength": 4096
    }
  },
  "required": [
    "schema_version",
    "emulation_id",
    "code",
    "regions",
    "call",
    "outputs",
    "budget"
  ],
  "additionalProperties": false
}
